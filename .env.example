# Origen público con el que se graban los tags NFC. Debe ser el dominio
# definitivo antes de grabar tags reales: cambiarlo obliga a regrabarlos.
VITE_PUBLIC_ORIGIN=https://instrumentacion-adb.web.app

# Configuración web del proyecto Firebase (Consola > Configuración del proyecto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=instrumentacion-adb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=instrumentacion-adb
VITE_FIREBASE_STORAGE_BUCKET=instrumentacion-adb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true para usar los emuladores locales de Firebase en desarrollo.
VITE_USE_EMULATORS=true
