rules_version = '2';

// Los permisos se aplican aquí, no solo en la interfaz. El rol viaja como
// custom claim `rol` (admin | tecnico | operador) y solo lo asigna una Cloud Function.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function rol() { return request.auth.token.get('rol', ''); }
    function conRol() { return conSesion() && rol() in ['admin', 'tecnico', 'operador']; }
    function tecnico() { return conSesion() && rol() in ['admin', 'tecnico']; }
    function admin() { return conSesion() && rol() == 'admin'; }

    function cambian() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function calibracionValida(d) {
      return d.fecha is timestamp
        && d.puntos is list && d.puntos.size() >= 1 && d.puntos.size() <= 11
        && d.resultado in ['Aprobada sin ajuste', 'Ajustada', 'Fuera de tolerancia']
        && d.tolerancia is number && d.tolerancia > 0
        && d.rangoMin is number && d.rangoMax is number && d.rangoMax > d.rangoMin
        && (d.proxima == null || d.proxima is timestamp)
        && d.observaciones is string && d.observaciones.size() <= 2000;
    }

    // Mensaje de chat a nombre de quien lo escribe, con texto o fotos.
    function mensajeValido(d, maxFotos) {
      return d.autor.uid == request.auth.uid
        && d.autor.nombre is string
        && d.texto is string && d.texto.size() <= 2000
        && d.fotos is list && d.fotos.size() <= maxFotos
        && (d.texto.size() > 0 || d.fotos.size() > 0)
        && d.fecha == request.time;
    }

    function instrumentoValido(d) {
      return d.tagISA is string && d.tagISA.size() >= 2 && d.tagISA.size() <= 16
        && d.servicio is string && d.servicio.size() >= 1 && d.servicio.size() <= 200
        && d.area in ['Generación de vapor', 'Almacenamiento de amoniaco', 'Tratamiento de agua']
        && d.estado in ['Operando', 'Con falla', 'Fuera de servicio']
        && (d.nfcToken == null || (d.nfcToken is string && d.nfcToken.matches('^[A-Za-z0-9]{16,22}$')))
        && d.docs is list && d.docs.size() <= 30;
    }

    match /usuarios/{uid} {
      allow read: if admin() || (conSesion() && request.auth.uid == uid);
      // Cada usuario solo registra sus tokens de notificación y, después de cambiar una
      // contraseña temporal, quita el aviso (nunca lo pone). El resto lo escriben las Functions.
      allow update: if (conSesion() && request.auth.uid == uid
          && cambian().hasOnly(['tokensFCM', 'cambiarContrasena'])
          && (!cambian().hasAny(['cambiarContrasena']) || request.resource.data.cambiarContrasena == false))
        // El admin asigna el área de cada usuario (define qué avisos de fallas le llegan).
        || (admin() && cambian().hasOnly(['area'])
          && request.resource.data.area in ['', 'Generación de vapor', 'Almacenamiento de amoniaco', 'Tratamiento de agua']);
    }

    match /instrumentos/{id} {
      allow read: if conRol();
      allow create: if tecnico() && instrumentoValido(request.resource.data)
        && request.resource.data.get('portadaMiniatura', null) == null;
      // portadaMiniatura la mantiene una Function a partir de la galería.
      allow update: if tecnico() && instrumentoValido(request.resource.data)
        && !cambian().hasAny(['portadaMiniatura']);
      allow delete: if admin();

      match /ubicacion/{fotoId} {
        allow read: if conRol();
        allow create, update: if tecnico()
          && request.resource.data.pie is string && request.resource.data.pie.size() <= 300
          && request.resource.data.orden is int
          && request.resource.data.esPortada is bool;
        allow delete: if tecnico();
      }

      // Calibraciones: las registra un técnico a su nombre; el registro no se edita
      // (solo el admin puede corregir o borrar).
      match /calibraciones/{calId} {
        allow read: if conRol();
        allow create: if tecnico() && calibracionValida(request.resource.data)
          && request.resource.data.tecnico.uid == request.auth.uid;
        allow update: if admin() && calibracionValida(request.resource.data);
        allow delete: if admin();
      }
    }

    // Precarga de miniaturas de todas las galerías (consulta de grupo).
    match /{ruta=**}/ubicacion/{fotoId} {
      allow read: if conRol();
    }

    // Reporte de calibraciones de todos los instrumentos (consulta de grupo).
    match /{ruta=**}/calibraciones/{calId} {
      allow read: if conRol();
    }

    // Fallas: Abierta → En proceso → Cerrada. Cualquiera con rol reporta;
    // solo técnicos y admin las toman y cierran.
    match /fallas/{id} {
      allow read: if conRol();
      allow create: if conRol()
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.reportadoPor.uid == request.auth.uid
        && request.resource.data.tecnicoAsignado == null
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 3 && request.resource.data.descripcion.size() <= 2000
        && request.resource.data.fotos is list && request.resource.data.fotos.size() <= 6
        && request.resource.data.causaRaiz == '' && request.resource.data.accionCorrectiva == ''
        && exists(/databases/$(database)/documents/instrumentos/$(request.resource.data.instrumentoId));
      allow update: if (tecnico() && cambioDeFallaValido())
        // El teléfono de quien reporta solo completa las URLs de sus fotos al subirlas.
        || (conRol() && resource.data.reportadoPor.uid == request.auth.uid
            && cambian().hasOnly(['fotos'])
            && request.resource.data.fotos.size() == resource.data.fotos.size());
      allow delete: if admin();

      // Chat de la falla: cualquiera con rol escribe mientras la falla no esté cerrada; al
      // cerrarse, lo escrito y las fotos se quedan para consulta. El autor solo completa
      // las URLs de sus fotos (también después del cierre, si se subieron sin señal).
      match /mensajes/{msgId} {
        allow read: if conRol();
        allow create: if conRol() && mensajeValido(request.resource.data, 4)
          && get(/databases/$(database)/documents/fallas/$(id)).data.estado != 'Cerrada';
        allow update: if conRol() && resource.data.autor.uid == request.auth.uid
          && cambian().hasOnly(['fotos'])
          && request.resource.data.fotos.size() == resource.data.fotos.size();
        allow delete: if admin();
      }
    }

    // Canal general del equipo (solo texto). La app muestra solo los de hoy;
    // los de días anteriores quedan como historial.
    match /chat_general/{msgId} {
      allow read: if conRol();
      allow create: if conRol() && mensajeValido(request.resource.data, 0);
      allow update: if false;
      allow delete: if admin();
    }

    // Chats privados entre dos personas. El id es "uidA_uidB" (en orden), así que basta
    // con el id para saber quién puede entrar. Nadie más los lee, ni el admin.
    function enChat(chatId) { return conRol() && request.auth.uid in chatId.split('_'); }

    function chatValido(chatId, d) {
      return d.miembros is list && d.miembros.size() == 2
        && d.miembros[0] < d.miembros[1]
        && chatId == d.miembros[0] + '_' + d.miembros[1]
        && d.nombres is map && d.leido is map
        && (d.ultimo == null || (d.ultimo.texto is string && d.ultimo.texto.size() <= 200));
    }

    match /chats_privados/{chatId} {
      allow get: if enChat(chatId);
      allow list: if conRol() && request.auth.uid in resource.data.miembros;
      // El último mensaje lo escribe quien lo manda, y cada quien solo marca lo que él ya leyó.
      allow create: if enChat(chatId) && chatValido(chatId, request.resource.data)
        && (request.resource.data.ultimo == null || request.resource.data.ultimo.autor == request.auth.uid)
        && request.resource.data.leido.keys().hasOnly([request.auth.uid]);
      allow update: if enChat(chatId) && chatValido(chatId, request.resource.data)
        && cambian().hasOnly(['ultimo', 'nombres', 'leido'])
        && (!cambian().hasAny(['ultimo']) || request.resource.data.ultimo.autor == request.auth.uid)
        && request.resource.data.leido.diff(resource.data.leido).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;

      match /mensajes/{msgId} {
        allow read: if enChat(chatId);
        allow create: if enChat(chatId) && mensajeValido(request.resource.data, 4);
        allow update: if enChat(chatId) && resource.data.autor.uid == request.auth.uid
          && cambian().hasOnly(['fotos'])
          && request.resource.data.fotos.size() == resource.data.fotos.size();
        allow delete: if false;
      }
    }

    // Directorio para elegir con quién chatear: nombre, rol y área, sin correos ni tokens.
    // Lo mantiene una Function; quien ya tenía cuenta se anota solo al abrir la app.
    match /directorio/{uid} {
      allow read: if conRol();
      allow create: if conRol() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'rol', 'area', 'activo'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.rol == rol()
        && request.resource.data.area is string && request.resource.data.area.size() <= 60
        && request.resource.data.activo == true;
      allow update, delete: if false;
    }

    function cambioDeFallaValido() {
      let antes = resource.data;
      let despues = request.resource.data;
      let fijos = !cambian().hasAny(['instrumentoId', 'tagISA', 'area', 'reportadoPor', 'descripcion'])
        && despues.fechas.creada == antes.fechas.creada;
      let cerrada = despues.estado == 'Cerrada'
        && despues.causaRaiz is string && despues.causaRaiz.size() >= 3
        && despues.accionCorrectiva is string && despues.accionCorrectiva.size() >= 3
        && despues.tecnicoAsignado != null;
      return fijos && antes.estado != 'Cerrada' && (
        (despues.estado == antes.estado)
        || (antes.estado == 'Abierta' && despues.estado == 'En proceso' && despues.tecnicoAsignado != null)
        || (antes.estado in ['Abierta', 'En proceso'] && cerrada)
      );
    }

    // Refacciones del almacén. La existencia solo cambia junto con un movimiento nuevo
    // (en el mismo lote) y exactamente en la cantidad del movimiento.
    function refaccionValida(d) {
      return d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
        && d.numeroParte is string && d.numeroParte.size() <= 60
        && d.marca is string && d.marca.size() <= 60
        && d.ubicacion is string && d.ubicacion.size() <= 120
        && d.unidad is string && d.unidad.size() >= 1 && d.unidad.size() <= 20
        && d.minimo is int && d.minimo >= 0 && d.minimo <= 100000
        && d.existencia is int
        && d.instrumentos is list && d.instrumentos.size() <= 200
        && d.notas is string && d.notas.size() <= 1000
        && (d.ultimoMovimiento == null || d.ultimoMovimiento is string);
    }

    function movimientoDelLote(refId, antes) {
      let movId = request.resource.data.ultimoMovimiento;
      let ruta = /databases/$(database)/documents/movimientos/$(movId);
      return movId is string && !exists(ruta) && existsAfter(ruta)
        && getAfter(ruta).data.refaccionId == refId
        && request.resource.data.existencia == antes + getAfter(ruta).data.cantidad;
    }

    match /refacciones/{id} {
      allow read: if conRol();
      allow create: if tecnico() && refaccionValida(request.resource.data)
        && ((request.resource.data.existencia == 0 && request.resource.data.ultimoMovimiento == null)
          || movimientoDelLote(id, 0));
      allow update: if tecnico() && refaccionValida(request.resource.data)
        && (!cambian().hasAny(['existencia', 'ultimoMovimiento'])
          || (cambian().hasOnly(['existencia', 'ultimoMovimiento', 'actualizado']) && movimientoDelLote(id, resource.data.existencia)));
      allow delete: if admin();
    }

    function movimientoValido(d) {
      return d.refaccionId is string
        && d.refaccionNombre is string && d.refaccionNombre.size() <= 120
        && d.tipo in ['entrada', 'salida', 'ajuste']
        && d.cantidad is int && d.cantidad != 0 && d.cantidad >= -100000 && d.cantidad <= 100000
        && (d.tipo != 'entrada' || d.cantidad > 0)
        && (d.tipo != 'salida' || d.cantidad < 0)
        && d.nota is string && d.nota.size() <= 300
        && d.quien.uid == request.auth.uid && d.quien.nombre is string
        && d.fecha == request.time
        && (d.fallaId == null || d.fallaId is string)
        && (d.instrumentoId == null || d.instrumentoId is string)
        && (d.tagISA == null || d.tagISA is string);
    }

    // Kardex: los movimientos no se editan ni se borran.
    match /movimientos/{movId} {
      allow read: if conRol();
      allow create: if tecnico() && movimientoValido(request.resource.data)
        && getAfter(/databases/$(database)/documents/refacciones/$(request.resource.data.refaccionId)).data.ultimoMovimiento == movId;
      allow update, delete: if false;
    }

    // Vista de invitado: solo se lee un documento por su token exacto; no se puede listar.
    match /publico/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Bitácora: la escriben triggers de Cloud Functions; nadie la edita ni la borra.
    match /auditoria/{id} {
      allow read: if tecnico();
      allow write: if false;
    }
  }
}
